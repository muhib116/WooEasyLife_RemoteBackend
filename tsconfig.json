{
    "compilerOptions": {
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "resources/js/*"
            ],
            "ziggy-js": [
                "./vendor/tightenco/ziggy"
            ]
        },
        "moduleResolution": "node",
        "module": "ES2020",
        "target": "ES2020", // Or ES2015, ES2017, etc.
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ]
    },
    "exclude": [
        "node_modules",
        "public"
    ]
}