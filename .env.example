APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Secret for POST /deploy (header X-Deploy-Secret). Generate: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_SECRET=
# First-time only: allow POST /deploy/setup (migrate + seed). Keep false on production.
DEPLOY_ALLOW_SETUP=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be > Blog Auto job timeout (900). Using 90 causes "attempted too many times".
QUEUE_RETRY_AFTER=1000

# This app reads CACHE_DRIVER (see config/cache.php), not CACHE_STORE.
# Default is database. Admins can also change it in System Maintenance.
CACHE_DRIVER=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=wpsalehub.com
MAIL_PORT=465
MAIL_USERNAME=support@wpsalehub.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@wpsalehub.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin recipient for subscription inquiry notifications
# LANDING_ADMIN_EMAIL=support@wpsalehub.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_SECRET_TOKEN=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USER=
PATHAO_PASSWORD=

STEADFAST_USER=
STEADFAST_PASSWORD=

PAPERFLY_USER=
PAPERFLY_PASSWORD=

REDX_PHONE=
REDX_PASSWORD=

CARRYBEE_PHONE=
CARRYBEE_PASSWORD=

FRAUD_CHECK_INCLUDE_REDX=true
FRAUD_CHECK_INCLUDE_CARRYBEE=true
# RedX + Carrybee delivery counts roll into totals
FRAUD_CHECK_AGGREGATE_REDX=true
FRAUD_CHECK_AGGREGATE_CARRYBEE=true

BULKSMS_API_KEY=
BULKSMS_SENDER_ID=8809617619992

# Static bearer token for POST /api/admin/plugins/versions
PLUGIN_UPLOAD_API_KEY=

# Subscription lifecycle (Phase 11)
SUBSCRIPTION_NOTIFICATIONS_ENABLED=true
SUBSCRIPTION_NOTIFY_EMAIL=true
SUBSCRIPTION_NOTIFY_SMS=false
SUBSCRIPTION_NOTIFY_WHATSAPP=false
SUBSCRIPTION_NOTIFY_MIN_SEVERITY=warning
SUBSCRIPTION_WHATSAPP_WEBHOOK_URL=
SUBSCRIPTION_PORTAL_URL="${APP_URL}"
SUBSCRIPTION_AUTO_DISABLE_TOKENS=true
SUBSCRIPTION_AUTO_DEACTIVATE_PLANS=true

# Plugin payment intent rules (subscribe / renew / upgrade / downgrade).
# Enable after the WordPress subscription modal is deployed to production.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT=true
# Keep true so merchant portal + admin payment forms are not blocked.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT_PLUGIN_ONLY=true
# Validate plugin-submitted base amount matches the selected plan (portal/admin unaffected).
SUBSCRIPTION_VALIDATE_PLUGIN_AMOUNTS=true

# One store domain per merchant globally (blocks duplicate trial via new accounts).
ENFORCE_GLOBAL_DOMAIN_UNIQUENESS=true

# Landing page app download links (optional — also editable in Admin → Platform → Landing Settings)
# WOOEASYLIFE_ANDROID_DOWNLOAD_URL=
# WOOEASYLIFE_PLAY_STORE_URL=
# WOOEASYLIFE_PLUGIN_DOWNLOAD_URL=
# SEO entity sameAs (Organization schema) — optional public profile URLs
# SEO_SAME_AS_FACEBOOK=
# Facebook Sharing Debugger "fb:app_id" (Meta → App Dashboard → App ID)
# SEO_FB_APP_ID=
# Or reuse login app id:
# FACEBOOK_CLIENT_ID=
# SEO_SAME_AS_YOUTUBE=
# SEO_SAME_AS_LINKEDIN=
# Google Search Console API (blog learning + rank opportunities + seo:weekly-report)
# Production checklist:
# 1) Enable Google Search Console API on the OAuth project
# 2) OAuth client → Authorized redirect URIs:
#    https://YOUR_PRODUCTION_DOMAIN/maintenance/gsc/callback
#    (and local: http://localhost:8000/maintenance/gsc/callback)
# 3) SEO_GSC_SITE_URL = exact verified GSC property (URL-prefix usually needs trailing /)
# 4) Admin → Maintenance → Connect Search Console (saves encrypted refresh token)
# 5) Probe GSC API, then run Blog learning insights
# Optional: SEO_GSC_REDIRECT_URI if APP_URL differs from the public callback host
# Optional: SEO_GSC_REFRESH_TOKEN only when no Connect-saved token exists (DB wins)
# SEO_GSC_SITE_URL=https://wooeasylife.com/
# SEO_GSC_REFRESH_TOKEN=
# SEO_GSC_REDIRECT_URI=
# Optional overrides (defaults to GOOGLE_CLIENT_*):
# SEO_GSC_CLIENT_ID=
# SEO_GSC_CLIENT_SECRET=
# Legacy short-lived token fallback:
# SEO_GSC_ACCESS_TOKEN=

# Optional GSC country filter (ISO 3166-1 alpha-3). Example Bangladesh: bgd
# SEO_GSC_COUNTRY=bgd

# Google Analytics Data API (GA4) — same OAuth client as GSC
# Production checklist:
# 1) Enable Google Analytics Data API + Google Analytics Admin API on the OAuth project
# 2) OAuth client → Authorized redirect URIs:
#    https://YOUR_PRODUCTION_DOMAIN/maintenance/ga/callback
#    (and local: http://localhost:8000/maintenance/ga/callback)
# 3) Set numeric Property ID in Admin → Blog AI Settings / SEO & Learning
#    (G-XXXX Measurement ID is also accepted after Connect — auto-resolved via Admin API)
# 4) Admin → Maintenance / SEO & Learning → Connect Google Analytics
# 5) Probe GA API
# Optional: SEO_GA_REDIRECT_URI if APP_URL differs from the public callback host
# Optional: SEO_GA_REFRESH_TOKEN only when no Connect-saved token exists (DB wins)
# Optional: SEO_GA_PROPERTY_ID only when no admin-saved property ID exists (DB wins)
# SEO_GA_PROPERTY_ID=
# SEO_GA_REFRESH_TOKEN=
# SEO_GA_REDIRECT_URI=
# Optional overrides (defaults to GOOGLE_CLIENT_*):
# SEO_GA_CLIENT_ID=
# SEO_GA_CLIENT_SECRET=
# Legacy short-lived token fallback:
# SEO_GA_ACCESS_TOKEN=

# Site Visitors analytics (public marketing pages → Admin → Analytics → Visitors)
# Requires CACHE_DRIVER=database|redis|file (not array) for dedupe/quotas.
# SITE_VISITORS_ENABLED=true
# SITE_VISITORS_MAX_REPORT_DAYS=90
# SITE_VISITORS_MAX_VIEWS_DAY=80
# SITE_VISITORS_MAX_HEARTBEATS_DAY=200
# SITE_VISITORS_ALLOWLIST_CACHE=300
# Verify: php artisan seo:gsc-status --probe

# Optional Inertia SSR (requires Node SSR process after npm run build:ssr)
# INERTIA_SSR_ENABLED=false
# INERTIA_SSR_URL=http://127.0.0.1:13714

# LANDING_WHATSAPP_DEFAULT_MESSAGE=সালাম, আমি WooEasyLife সাবস্ক্রিপশন নিতে চাই।
# Optional env fallbacks (prefer Admin → Landing Settings in production):
# LANDING_WHATSAPP_PHONE=
# LANDING_HELPLINE_PHONE=
# LANDING_BKASH_NUMBER=
# LANDING_ROCKET_NUMBER=
# LANDING_NAGAD_NUMBER=
# LANDING_META_PIXEL_ID=
# OPENAI_API_KEY=
# OPENAI_BLOG_MODEL=gpt-4o-mini
# OPENAI_BLOG_PLANNING_MODEL=gpt-4.1-mini
# OPENAI_BLOG_WRITING_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-1
# Blog AI — leave QUEUE=false for local (no queue:work needed).
# Production (cPanel) required:
#   QUEUE_CONNECTION=database
#   QUEUE_RETRY_AFTER=1000
#   BLOG_AI_QUEUE=true
# Cron every minute (allow long Auto jobs — do NOT use --max-time=55):
#   cd /home/USER/app.wpsalehub.com && /usr/local/bin/php artisan queue:work database --stop-when-empty --max-jobs=1 --timeout=900 --tries=1 --memory=512 >> storage/logs/queue-cron.log 2>&1
# BLOG_AI_ENABLED=true
# BLOG_AI_QUEUE=false
# BLOG_AI_AUTO_ENABLED=true
# BLOG_AI_AUTO_REQUIRE_QUEUE=
# BLOG_AI_AUTO_MAX_REVISIONS=2
# BLOG_AI_AUTO_SOFT_PASS_CAP=59
# BLOG_AI_AUTO_ALLOW_DRAFT_SOFT_PASS=true
# BLOG_AI_AUTO_LLM_REVIEW=true
# BLOG_AI_IMAGE_ENABLED=true
# Auto Create cover generation (false = skip covers in Auto; manual wizard still works).
# BLOG_AI_AUTO_IMAGE=false
# Cover banners: Latin/English text only (AI garbles Bangla). Author-only identity by default.
# BLOG_AI_IMAGE_LATIN_TEXT_ONLY=true
# BLOG_AI_IMAGE_STYLE_REFS=false
# BLOG_AI_IMAGE_INPUT_FIDELITY=high
# BLOG_AI_IMAGE_REVIEW_SCORE=72
# BLOG_AI_IMAGE_MAX_ATTEMPTS=3
# BLOG_AI_AUTO_IMAGE_ATTEMPTS=1
# BLOG_AI_DAILY_SESSION_CAP=20
# BLOG_AI_DAILY_CALLS_CAP=80
# BLOG_AI_DAILY_TOKEN_CAP=400000
# BLOG_AI_REQUIRE_KEYWORDS=true
# BLOG_AI_AUTHOR_NAME="Muhibbullah Ansary"
# BLOG_AI_MIN_BODY_WORDS=1200
# BLOG_AI_GLOSSARY_MIN_BODY_WORDS=800
# BLOG_AI_DEFAULT_ARTICLE_TYPE=howto
# BLOG_COMPETITOR_ANALYZER=true
# BLOG_COMPETITOR_IN_PROMPTS=true
# BLOG_COMPETITOR_DISCOVERY=true
# BLOG_COMPETITOR_SEARCH_PROVIDER=auto
# BLOG_COMPETITOR_SEARCH_API_KEY=
# BLOG_COMPETITOR_BING_API_KEY=
# BLOG_COMPETITOR_DISCOVERY_MAX=5
# BLOG_COMPETITOR_AUTO_ON_SMART=true
# BLOG_COMPETITOR_EXCLUDE_HOSTS=wpsalehub.com,www.wpsalehub.com,app.wpsalehub.com,wooeasylife.com,www.wooeasylife.com
# BLOG_AI_SMART_ONE_CLICK=true
# BLOG_AI_SMART_PREFER_GSC=true
# BLOG_LANDING_REF_FETCH=true
# BLOG_LANDING_PUBLIC_BASE_URL=
# BLOG_LANDING_REF_ALLOWED_HOSTS=
# BLOG_AI_LP_KEYWORD_GUARD=true
#
# Progressive publish gates (drafts never blocked — only status=published):
# C1 on by default. Enable INTERNAL_LINK after C1 is stable (3–5 days).
# Do NOT enable AI_READY or OG_IMAGE until Fix-checklist is routine.
# BLOG_SEO_ENFORCE_FOCUS_KEYWORD=true
# BLOG_SEO_ENFORCE_INTERNAL_LINK=false
# BLOG_SEO_ENFORCE_OG_IMAGE=false
# BLOG_SEO_ENFORCE_AI_READY=false
# Soft-pass Auto drafts cannot publish until Fix SEO checklist clears the flag:
# BLOG_SEO_BLOCK_SOFT_PASS_PUBLISH=true
# LANDING_CONVERT_NOTIFY_EMAIL=true
# LANDING_CONVERT_NOTIFY_SMS=true
# SUBSCRIPTION_PAYMENT_BKASH=
# SUBSCRIPTION_PAYMENT_ROCKET=
# SUBSCRIPTION_PAYMENT_NAGAD=
# WOOEASYLIFE_ANDROID_DOWNLOAD_URL=
# WOOEASYLIFE_PLAY_STORE_URL=
# WOOEASYLIFE_PLUGIN_DOWNLOAD_URL=

# Public landing fraud check (free daily searches)
# LANDING_FRAUD_CHECK_ENABLED=true
# LANDING_FRAUD_CHECK_DAILY_LIMIT=5

# Order intelligence network (global customer/order analytics)
ORDER_INTELLIGENCE_ENABLED=true
ORDER_INTELLIGENCE_CACHE_ENABLED=true
ORDER_INTELLIGENCE_CACHE_TTL=900
ORDER_INTELLIGENCE_FRAUD_CHECK_MODE=hybrid
ORDER_INTELLIGENCE_MIN_PLATFORM_ORDERS=1
ORDER_INTELLIGENCE_MAX_STATS_STALENESS_HOURS=72
# Courier snapshot cache TTL (hours). After this, serve cache + refresh in background.
ORDER_INTELLIGENCE_MAX_SNAPSHOT_STALENESS_HOURS=5
ORDER_INTELLIGENCE_STALE_WHILE_REVALIDATE=true
ORDER_INTELLIGENCE_PRESERVE_SNAPSHOT_ON_FAILURE=true
# Min seconds between live refreshes for the same phone
ORDER_INTELLIGENCE_REFRESH_UNIQUE_FOR=900
# Re-fetch only failed/stale couriers in background (not all five)
ORDER_INTELLIGENCE_PARTIAL_REFRESH=true
# Admin fraud-check decision trail + Log::debug (also toggleable in Fraud Checker UI)
ORDER_INTELLIGENCE_DEBUG_TRACE=false
ORDER_INTELLIGENCE_SUGGEST_ENABLED=true
ORDER_INTELLIGENCE_SEARCH_ENABLED=true
ORDER_INTELLIGENCE_SEARCH_DRIVER=database
ORDER_INTELLIGENCE_ANALYTICS_ENABLED=true
# ORDER_INTELLIGENCE_SUGGEST_MIN_LENGTH=3
# ORDER_INTELLIGENCE_SUGGEST_LIMIT=8
# ORDER_INTELLIGENCE_ANALYTICS_PRODUCT_LIMIT=20
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# MEILISEARCH_CUSTOMER_INDEX=platform_customers

# Merchant social login (Google / Facebook OAuth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/marchent/auth/google/callback"
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/marchent/auth/facebook/callback"
# Facebook Page share (admin blog list) — Page token from GET /me/accounts
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# Public SEO courier charge calculator — Pathao live samples (optional).
# Steadfast syncs from https://www.steadfast.com.bd/welcome/get/pricing-data (no key).
# COURIER_PUBLIC_RATES_PATHAO_USER_ID=
# COURIER_PUBLIC_RATES_PATHAO_DHAKA_CITY=
# COURIER_PUBLIC_RATES_PATHAO_DHAKA_ZONE=
# COURIER_PUBLIC_RATES_PATHAO_SUBURB_CITY=
# COURIER_PUBLIC_RATES_PATHAO_SUBURB_ZONE=
# COURIER_PUBLIC_RATES_PATHAO_OUTSIDE_CITY=
# COURIER_PUBLIC_RATES_PATHAO_OUTSIDE_ZONE=
# FACEBOOK_GRAPH_VERSION=v21.0
# Public site for captions/OG when APP_URL is localhost (e.g. https://wooeasylife.com)
# FACEBOOK_SHARE_BASE_URL=

# Messenger Page OAuth (Woo Easy Life plugin one-click connect)
# Reuses FACEBOOK_CLIENT_ID/SECRET unless META_APP_* is set.
# META_APP_ID=
# META_APP_SECRET=
# Messenger has its own OAuth callback — never reuse FACEBOOK_REDIRECT_URI (merchant login).
# META_MESSENGER_REDIRECT_URI="${APP_URL}/api/messenger/oauth/callback"
# META_MESSENGER_WEBHOOK_VERIFY_TOKEN=
# META_MESSENGER_SCOPES=pages_show_list,pages_messaging,pages_manage_metadata,pages_read_engagement,instagram_basic,instagram_manage_messages
# Preferred for newer Meta apps (avoids "Invalid Scopes"): create a Login for Business
# configuration that includes Page + Messenger permissions, then set:
# META_MESSENGER_LOGIN_CONFIG_ID=
# Meta webhook callback URL: ${APP_URL}/api/webhooks/messenger
#
# Single-page direct connect: skips the Facebook login dialog and attaches the
# Page token below to every license that connects. Use for development or a
# single-Page hub only; leave false for multi-tenant SaaS.
# META_MESSENGER_DIRECT_CONNECT=false
# Defaults to FACEBOOK_PAGE_ID / FACEBOOK_PAGE_ACCESS_TOKEN when unset.
# META_MESSENGER_PAGE_ID=
# META_MESSENGER_PAGE_ACCESS_TOKEN=
