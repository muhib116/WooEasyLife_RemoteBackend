APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Secret for POST /deploy (header X-Deploy-Secret). Generate: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_SECRET=
# First-time only: allow POST /deploy/setup (migrate + seed). Keep false on production.
DEPLOY_ALLOW_SETUP=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# This app reads CACHE_DRIVER (see config/cache.php), not CACHE_STORE.
CACHE_DRIVER=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=wpsalehub.com
MAIL_PORT=465
MAIL_USERNAME=support@wpsalehub.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@wpsalehub.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin recipient for subscription inquiry notifications
# LANDING_ADMIN_EMAIL=support@wpsalehub.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_SECRET_TOKEN=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USER=
PATHAO_PASSWORD=

STEADFAST_USER=
STEADFAST_PASSWORD=

PAPERFLY_USER=
PAPERFLY_PASSWORD=

REDX_PHONE=
REDX_PASSWORD=

CARRYBEE_PHONE=
CARRYBEE_PASSWORD=

FRAUD_CHECK_INCLUDE_REDX=true
FRAUD_CHECK_INCLUDE_CARRYBEE=true
# RedX + Carrybee delivery counts roll into totals
FRAUD_CHECK_AGGREGATE_REDX=true
FRAUD_CHECK_AGGREGATE_CARRYBEE=true

BULKSMS_API_KEY=
BULKSMS_SENDER_ID=8809617619992

# Static bearer token for POST /api/admin/plugins/versions
PLUGIN_UPLOAD_API_KEY=

# Subscription lifecycle (Phase 11)
SUBSCRIPTION_NOTIFICATIONS_ENABLED=true
SUBSCRIPTION_NOTIFY_EMAIL=true
SUBSCRIPTION_NOTIFY_SMS=false
SUBSCRIPTION_NOTIFY_WHATSAPP=false
SUBSCRIPTION_NOTIFY_MIN_SEVERITY=warning
SUBSCRIPTION_WHATSAPP_WEBHOOK_URL=
SUBSCRIPTION_PORTAL_URL="${APP_URL}"
SUBSCRIPTION_AUTO_DISABLE_TOKENS=true
SUBSCRIPTION_AUTO_DEACTIVATE_PLANS=true

# Plugin payment intent rules (subscribe / renew / upgrade / downgrade).
# Enable after the WordPress subscription modal is deployed to production.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT=true
# Keep true so merchant portal + admin payment forms are not blocked.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT_PLUGIN_ONLY=true
# Validate plugin-submitted base amount matches the selected plan (portal/admin unaffected).
SUBSCRIPTION_VALIDATE_PLUGIN_AMOUNTS=true

# One store domain per merchant globally (blocks duplicate trial via new accounts).
ENFORCE_GLOBAL_DOMAIN_UNIQUENESS=true

# Landing page app download links (optional — also editable in Admin → Platform → Landing Settings)
# WOOEASYLIFE_ANDROID_DOWNLOAD_URL=
# WOOEASYLIFE_PLAY_STORE_URL=
# WOOEASYLIFE_PLUGIN_DOWNLOAD_URL=
# SEO entity sameAs (Organization schema) — optional public profile URLs
# SEO_SAME_AS_FACEBOOK=
# SEO_SAME_AS_YOUTUBE=
# SEO_SAME_AS_LINKEDIN=
# LANDING_WHATSAPP_DEFAULT_MESSAGE=সালাম, আমি WooEasyLife সাবস্ক্রিপশন নিতে চাই।
# Optional env fallbacks (prefer Admin → Landing Settings in production):
# LANDING_WHATSAPP_PHONE=
# LANDING_HELPLINE_PHONE=
# LANDING_BKASH_NUMBER=
# LANDING_ROCKET_NUMBER=
# LANDING_NAGAD_NUMBER=
# LANDING_CONVERT_NOTIFY_EMAIL=true
# LANDING_CONVERT_NOTIFY_SMS=true
# SUBSCRIPTION_PAYMENT_BKASH=
# SUBSCRIPTION_PAYMENT_ROCKET=
# SUBSCRIPTION_PAYMENT_NAGAD=
# WOOEASYLIFE_ANDROID_DOWNLOAD_URL=
# WOOEASYLIFE_PLAY_STORE_URL=
# WOOEASYLIFE_PLUGIN_DOWNLOAD_URL=

# Public landing fraud check (free daily searches)
# LANDING_FRAUD_CHECK_ENABLED=true
# LANDING_FRAUD_CHECK_DAILY_LIMIT=5

# Order intelligence network (global customer/order analytics)
ORDER_INTELLIGENCE_ENABLED=true
ORDER_INTELLIGENCE_CACHE_ENABLED=true
ORDER_INTELLIGENCE_CACHE_TTL=900
ORDER_INTELLIGENCE_FRAUD_CHECK_MODE=hybrid
ORDER_INTELLIGENCE_MIN_PLATFORM_ORDERS=1
ORDER_INTELLIGENCE_MAX_STATS_STALENESS_HOURS=72
# Courier snapshot cache TTL (hours). After this, serve cache + refresh in background.
ORDER_INTELLIGENCE_MAX_SNAPSHOT_STALENESS_HOURS=5
ORDER_INTELLIGENCE_STALE_WHILE_REVALIDATE=true
ORDER_INTELLIGENCE_PRESERVE_SNAPSHOT_ON_FAILURE=true
# Min seconds between live refreshes for the same phone
ORDER_INTELLIGENCE_REFRESH_UNIQUE_FOR=900
# Re-fetch only failed/stale couriers in background (not all five)
ORDER_INTELLIGENCE_PARTIAL_REFRESH=true
# Admin fraud-check decision trail + Log::debug (also toggleable in Fraud Checker UI)
ORDER_INTELLIGENCE_DEBUG_TRACE=false
ORDER_INTELLIGENCE_SUGGEST_ENABLED=true
ORDER_INTELLIGENCE_SEARCH_ENABLED=true
ORDER_INTELLIGENCE_SEARCH_DRIVER=database
ORDER_INTELLIGENCE_ANALYTICS_ENABLED=true
# ORDER_INTELLIGENCE_SUGGEST_MIN_LENGTH=3
# ORDER_INTELLIGENCE_SUGGEST_LIMIT=8
# ORDER_INTELLIGENCE_ANALYTICS_PRODUCT_LIMIT=20
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# MEILISEARCH_CUSTOMER_INDEX=platform_customers

# Merchant social login (Google / Facebook OAuth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/marchent/auth/google/callback"
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/marchent/auth/facebook/callback"
