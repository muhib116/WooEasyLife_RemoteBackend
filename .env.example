APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

DEPLOY_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_SECRET_TOKEN=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USER=
PATHAO_PASSWORD=

STEADFAST_USER=
STEADFAST_PASSWORD=

PAPERFLY_USER=
PAPERFLY_PASSWORD=

REDX_PHONE=
REDX_PASSWORD=

BULKSMS_API_KEY=
BULKSMS_SENDER_ID=8809617619992

# Subscription lifecycle (Phase 11)
SUBSCRIPTION_NOTIFICATIONS_ENABLED=true
SUBSCRIPTION_NOTIFY_EMAIL=true
SUBSCRIPTION_NOTIFY_SMS=false
SUBSCRIPTION_NOTIFY_WHATSAPP=false
SUBSCRIPTION_NOTIFY_MIN_SEVERITY=warning
SUBSCRIPTION_WHATSAPP_WEBHOOK_URL=
SUBSCRIPTION_PORTAL_URL="${APP_URL}"
SUBSCRIPTION_AUTO_DISABLE_TOKENS=true
SUBSCRIPTION_AUTO_DEACTIVATE_PLANS=true

# Plugin payment intent rules (subscribe / renew / upgrade / downgrade).
# Enable after the WordPress subscription modal is deployed to production.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT=true
# Keep true so merchant portal + admin payment forms are not blocked.
SUBSCRIPTION_ENFORCE_PAYMENT_INTENT_PLUGIN_ONLY=true
# Validate plugin-submitted base amount matches the selected plan (portal/admin unaffected).
SUBSCRIPTION_VALIDATE_PLUGIN_AMOUNTS=true

# One store domain per merchant globally (blocks duplicate trial via new accounts).
ENFORCE_GLOBAL_DOMAIN_UNIQUENESS=true

# Landing page app download links (optional)
# WOOEASYLIFE_ANDROID_DOWNLOAD_URL=
# WOOEASYLIFE_PLAY_STORE_URL=
# LANDING_WHATSAPP_PHONE=8801790989591
# LANDING_WHATSAPP_DEFAULT_MESSAGE=সালাম, আমি WooEasyLife সম্পর্কে জানতে চাই।
# LANDING_HELPLINE_PHONE=8801790989591

# Public landing fraud check (free daily searches)
# LANDING_FRAUD_CHECK_ENABLED=true
# LANDING_FRAUD_CHECK_DAILY_LIMIT=5

# Manual payment account numbers (subscription + SMS recharge instructions)
PAYMENT_BKASH_ACCOUNT=01770-989591
PAYMENT_ROCKET_ACCOUNT=01770-989591-9
